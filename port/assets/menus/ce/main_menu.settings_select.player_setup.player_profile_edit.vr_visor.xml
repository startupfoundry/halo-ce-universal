	<strings name="main_menu/settings_select/player_setup/player_profile_edit/vr_visor/help_strings">
		<string text=""/>
		<string text="On your helmet's visor, curved about your eyes,\nor a flat screen before them."/>
		<string text="How far apart in depth the HUD's parts are: the\ntracker nearest, the waypoints farthest."/>
		<string text="How far the HUD trails your head's turns."/>
		<string text="The HUD's glow on the visor's glass."/>
		<string text="The helmet's faceplate about the visor, at the\nedges of your view, in depth."/>
		<string text="How far before your eyes the helmet's rim is."/>
		<string text="The helmet's shadow on the glass at the edges of\nyour view, and the glass's faint gold."/>
		<string text="The shields on the glass: their energy, the red\nwarning, the HUD's flicker as they break."/>
		<string text="How strong the shields' energy across the glass\nis, as they are hit and as they recharge."/>
	</strings>
